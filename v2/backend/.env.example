# 공공데이터포털 운영계정 서비스키
DATAGOKR=

# Cloud Run 운영 시 firestore 권장, 로컬 개발 시 memory
ADDRESS_CACHE_BACKEND=memory

# Firestore 사용 시 공공 API 캐시 컬렉션
ADDRESS_CACHE_COLLECTION=local_economy_address_cache

# Firestore 사용 시 사용자가 직접 확인해 저장한 주소 컬렉션
MANUAL_ADDRESS_COLLECTION=local_economy_manual_addresses

# 업체 주소 병렬 조회 수 (1~4, 기본 2)
ADDRESS_LOOKUP_WORKERS=2

# 필요 시 공식 반기보고서 템플릿 경로 지정
# HALFYEAR_TEMPLATE_PATH=/app/templates/halfy_report_template.xlsx
