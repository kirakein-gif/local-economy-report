# 공공데이터포털 운영계정 서비스키
DATAGOKR=

# Cloud Run 운영 시 firestore 권장, 로컬 개발 시 memory
ADDRESS_CACHE_BACKEND=memory

# Firestore 공공 API 캐시 컬렉션
ADDRESS_CACHE_COLLECTION=local_economy_address_cache

# Firestore 사용자가 직접 확인해 저장한 주소 컬렉션
MANUAL_ADDRESS_COLLECTION=local_economy_manual_addresses

# 내부 이관 완료표시 등 시스템 메타데이터
SYSTEM_COLLECTION=local_economy_system

# 기존 Streamlit 수동주소 스냅샷을 Firestore로 안전 이관
# 이미 Firestore에 있는 사업자번호는 절대 덮어쓰지 않음
LEGACY_MANUAL_MIGRATION_ENABLED=1
LEGACY_MANUAL_ADDRESS_FILE=/app/data/manual_addresses.json

# 업체 주소 병렬 조회 수 (1~4, 기본 2)
ADDRESS_LOOKUP_WORKERS=2

# 필요 시 공식 반기보고서 Base64 조각 경로 지정
# TEMPLATE_PARTS_DIR=/app/template_parts
